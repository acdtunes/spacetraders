    {
      "type": "table",
      "title": "Gate Supply Chain \u2014 supply & activity at each link's cheapest source",
      "description": "Tier 0 is the gate bill; deeper tiers are its recursive inputs. Source is the cheapest market per good, preferring EXPORT.",
      "id": 10,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql"
      },
      "gridPos": {
        "h": 12,
        "w": 18,
        "x": 6,
        "y": 13
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Supply"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "SCARCE": {
                        "color": "red",
                        "index": 0
                      },
                      "LIMITED": {
                        "color": "orange",
                        "index": 1
                      },
                      "MODERATE": {
                        "color": "yellow",
                        "index": 2
                      },
                      "HIGH": {
                        "color": "green",
                        "index": 3
                      },
                      "ABUNDANT": {
                        "color": "blue",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Activity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "RESTRICTED": {
                        "color": "red",
                        "index": 0
                      },
                      "WEAK": {
                        "color": "orange",
                        "index": 1
                      },
                      "GROWING": {
                        "color": "green",
                        "index": 2
                      },
                      "STRONG": {
                        "color": "blue",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgresql"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH chain(good, tier) AS (VALUES\n  ('FAB_MATS',0),('ADVANCED_CIRCUITRY',0),('QUANTUM_STABILIZERS',0),\n  ('IRON',1),('QUARTZ_SAND',1),('ELECTRONICS',1),('MICROPROCESSORS',1),('PLATINUM',1),\n  ('IRON_ORE',2),('SILICON_CRYSTALS',2),('COPPER',2),('PLATINUM_ORE',2),\n  ('EXPLOSIVES',3),('COPPER_ORE',3),\n  ('LIQUID_HYDROGEN',4),('LIQUID_NITROGEN',4),('MACHINERY',5)),\nbest AS (\n  SELECT DISTINCT ON (c.good) c.tier, c.good, m.waypoint_symbol, m.trade_type,\n         m.supply, m.activity, m.purchase_price, m.trade_volume, m.last_updated\n  FROM chain c\n  LEFT JOIN market_data m ON m.good_symbol = c.good\n       AND m.player_id = (SELECT MAX(id) FROM players)\n  ORDER BY c.good,\n           CASE m.trade_type WHEN 'EXPORT' THEN 1 WHEN 'EXCHANGE' THEN 2 ELSE 3 END,\n           m.purchase_price ASC NULLS LAST)\nSELECT tier AS \"Tier\", good AS \"Good\",\n       COALESCE(waypoint_symbol,'(no market)') AS \"Source\",\n       COALESCE(trade_type,'-') AS \"Type\",\n       COALESCE(supply,'-') AS \"Supply\",\n       COALESCE(NULLIF(activity,''),'-') AS \"Activity\",\n       COALESCE(purchase_price,0) AS \"Ask\",\n       COALESCE(trade_volume,0) AS \"Vol\",\n       ROUND(EXTRACT(EPOCH FROM (NOW() - last_updated))/60) AS \"Age (min)\"\nFROM best ORDER BY tier, good;",
          "refId": "A"
        }
      ]
    }
