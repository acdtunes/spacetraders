        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgresql"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT m->>'tradeSymbol' || '  ' || (m->>'deliveredQuantity') || '/' || (m->>'targetQuantity') AS \"Material\", ROUND(100.0 * (m->>'deliveredQuantity')::numeric / NULLIF((m->>'targetQuantity')::numeric, 0), 1) AS \"Delivered\" FROM manufacturing_pipelines p CROSS JOIN LATERAL jsonb_array_elements(p.materials) AS m WHERE p.status = 'EXECUTING' AND p.construction_site IS NOT NULL ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Materials: Delivered vs Target",
      "type": "bargauge"
