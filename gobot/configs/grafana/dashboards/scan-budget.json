    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The noise-free form of the self-check: cumulative endpoint requests divided by cumulative scan-budget spends, since process start. 100% = perfect agreement. Immune to the rate-window jitter that makes the timeseries to the left look divergent. A steady ~99% is EXPECTED and healthy - the budget counter is incremented just before the HTTP call, so one in-flight request is permanently counted by the budget and not yet by the endpoint. Measured live at build time: market 117/118, shipyard 195/196. AMBER outside 95-105%, RED outside 90-110% - that is real divergence and voids this dashboard. api_requests_total carries NO player_id label - do not add $player to those two targets, it would return empty. Verified against /metrics.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
