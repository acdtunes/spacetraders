    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "THE INVARIANT: total cost does NOT grow with the charted map. Coverage (waypoints sharing the allowance, LEFT axis) should CLIMB as the map is charted while the spend rate (RIGHT axis) stays FLAT - a growing map lengthens each waypoint's interval instead of raising the request rate. Coverage and the allowance are GAUGES, so this panel uses max(), never rate(). If both lines climb together the invariant is broken and scanning cost is scaling with the map.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
