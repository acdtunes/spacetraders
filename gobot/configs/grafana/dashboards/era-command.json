          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(amount), 0)::float AS net_profit\n  FROM transactions\n WHERE created_at >= NOW() - INTERVAL '24 hours'\n   AND player_id = (SELECT MAX(id) FROM players)",
          "editorMode": "code",
          "hide": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(spacetraders_daemon_api_requests_total[24h]))",
          "instant": true,
          "range": false,
          "hide": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "$A / $B"
