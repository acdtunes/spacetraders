    {
      "type": "stat",
      "id": 3,
      "title": "Fleet Inventory Value (at COST)",
      "description": "Cargo aboard, valued at what we paid \u2014 not market. Goods with no purchase record count 0.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "unit": "locale",
          "decimals": 0,
          "noValue": "0",
