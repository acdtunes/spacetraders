      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgresql"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH me AS (SELECT MAX(id) AS pid FROM players),\nfleet_inv AS (\n  SELECT g->>'symbol' AS good, SUM((g->>'units')::int) AS units\n    FROM ships s CROSS JOIN me, jsonb_array_elements(s.cargo_inventory::jsonb) g\n   WHERE s.player_id = me.pid AND s.cargo_units > 0\n   GROUP BY 1),\ncost AS (\n  SELECT t.metadata->>'good_symbol' AS good,\n         SUM(-t.amount) / NULLIF(SUM((t.metadata->>'units')::numeric), 0) AS avg_unit_cost\n    FROM transactions t CROSS JOIN me\n   WHERE t.player_id = me.pid AND t.transaction_type = 'PURCHASE_CARGO'\n     AND COALESCE(t.metadata->>'good_symbol','') <> ''\n   GROUP BY 1)\nSELECT COALESCE(SUM(f.units * COALESCE(c.avg_unit_cost, 0)), 0)::bigint AS \"at cost\"\n  FROM fleet_inv f LEFT JOIN cost c ON c.good = f.good;",
          "editorMode": "code"
        }
      ]
    },
