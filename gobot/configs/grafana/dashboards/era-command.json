{
  "uid": "spacetraders-era-command",
  "title": "SpaceTraders - Era Command",
  "description": "Single-screen command view of the current era: position (treasury, inventory at cost, hull counts, API cost), net performance over the selected window, and the trend lines behind it. Assembled from the live-validated panels in financial.json, trading-hulls.json and frontier.json (sp-iv3lt).",
  "tags": [
    "spacetraders",
    "command",
    "financial"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "player",
        "label": "Player",
        "description": "Current era's player id, taken straight from MAX(id) so it re-points itself across an era rollover with no edit. Used to scope the Prometheus ledger panels the same way every SQL panel scopes itself. sort=4 (numeric desc) is deliberate: sp-ox2mj showed an unsorted player variable defaulting to the DEAD prior era during a Prometheus retention overlap.",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "postgresql"
        },
        "definition": "SELECT MAX(id) FROM players",
        "query": "SELECT MAX(id) FROM players",
        "current": {},
        "options": [],
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 4
      },
      {
        "name": "smooth",
        "label": "Smoothing",
        "description": "rate() smoothing window applied to the 'Net P/L per Hour by Operation' panel - a larger window is a smoother, slower-moving line. The Operating Profit/hr panel keeps its own fixed 1h/3h/6h windows and ignores this.",
        "type": "interval",
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "current": {
          "selected": true,
          "text": "3h",
          "value": "3h"
        },
        "options": [
          {
            "selected": false,
            "text": "1h",
            "value": "1h"
          },
          {
            "selected": true,
            "text": "3h",
            "value": "3h"
          },
          {
            "selected": false,
            "text": "6h",
            "value": "6h"
          },
          {
            "selected": false,
            "text": "12h",
            "value": "12h"
          }
        ],
        "query": "1h,3h,6h,12h",
        "queryValue": "",
        "hide": 0,
        "refresh": 2,
        "skipUrlSync": false
      }
    ]
  },
