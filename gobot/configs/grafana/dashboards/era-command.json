        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgresql"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(\"timestamp\", $__interval),\n       AVG(balance_after) AS \"treasury\"\n  FROM transactions\n WHERE $__timeFilter(\"timestamp\")\n   AND player_id = (SELECT MAX(id) FROM players)\n GROUP BY 1 ORDER BY 1",
          "editorMode": "code"
        }
      ]
